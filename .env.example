DATABASE_URL=postgresql://postgres:postgres@localhost:5432/solcage
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Set only after deploying and verifying the program.
SOLCAGE_LENDING_PROGRAM_ID=
SOLCAGE_VAULT_AUTHORITY=
SOLCAGE_BORROW_MINT=
SOLCAGE_BORROW_DECIMALS=6

# One-line JSON. Example values below are intentionally empty placeholders.
# tokenProgram defaults to the classic SPL Token program when omitted.
SOLCAGE_COLLATERAL_MARKETS=[]
