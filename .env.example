DATABASE_URL=postgresql://postgres:postgres@localhost:5432/solcage
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Custodial lending operator. Keep disabled until the mint exists on the selected
# network, the wallet has SOL and USDC inventory, and the swap adapter is ready.
SOLCAGE_CUSTODY_ENABLED=false
SOLCAGE_CUSTODY_WALLET=
SOLCAGE_CUSTODY_SECRET_KEY=
SOLCAGE_CUSTODY_USDC_MINT=
SOLCAGE_CUSTODY_USDC_DECIMALS=6
SOLCAGE_CUSTODY_USDC_TOKEN_PROGRAM=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA
SOLCAGE_CUSTODY_SWAP_MODE=simulated
JUPITER_API_KEY=

# One-line JSON. simulatedPriceMicros is used only by the devnet adapter.
SOLCAGE_CUSTODY_MARKET={"symbol":"SOLCAGE","name":"SolCage","mint":"","decimals":6,"tokenProgram":"TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA","advanceBps":2000,"simulatedPriceMicros":"1000000","maxPositionRaw":"1000000000","maxActiveLiabilityRaw":"10000000000","enabled":false}

# Set only on the Sites frontend so custody requests are handled by Railway.
SOLCAGE_CUSTODY_BACKEND_URL=

# ---------------------------------------------------------------------------
# House bankroll (real-money wagering)
#
# Must NOT be the custody wallet: custody holds reserves owed to borrowers, and
# a losing night on a shared wallet would eat money owed on lending claims.
SOLCAGE_HOUSE_ENABLED=false
SOLCAGE_HOUSE_WALLET=
SOLCAGE_HOUSE_SECRET_KEY=
SOLCAGE_HOUSE_SYMBOL=SOL
SOLCAGE_HOUSE_DECIMALS=9
# Set only when players wager an SPL token instead of native SOL.
SOLCAGE_HOUSE_MINT=

# Base units. Stakes are bounded by min/max; tail risk is bounded by the payout
# ceiling, which is applied at settlement so high-multiplier games stay playable.
SOLCAGE_MIN_STAKE_RAW=10000000
SOLCAGE_MAX_STAKE_RAW=250000000
SOLCAGE_MAX_PAYOUT_RAW=1000000000000000

# House rake in basis points, taken off each stake. Capped at 1000 in code.
SOLCAGE_RAKE_BPS=200
# Where swept rake is sent. Defaults to SOLCAGE_CUSTODY_WALLET when unset.
SOLCAGE_RAKE_DESTINATION=

# Withdrawals above this, or over the daily velocity, queue for operator review.
SOLCAGE_WITHDRAWAL_REVIEW_RAW=1000000000
SOLCAGE_WITHDRAWAL_DAILY_MAX_RAW=5000000000
SOLCAGE_WITHDRAWAL_DAILY_MAX_COUNT=10

# Games withheld from the floor, comma separated. Hidden games are removed
# from the lobby and refuse wagers.
NEXT_PUBLIC_SOLCAGE_HIDDEN_GAMES=

# Operator bearer token for /api/admin/withdrawals. Under 32 chars disables the
# endpoint rather than leaving it open.
SOLCAGE_ADMIN_TOKEN=

# Skip TLS chain verification for a managed database whose CA Node cannot
# validate (Supabase's pooler presents a self-signed chain).
DATABASE_SSL_NO_VERIFY=false
