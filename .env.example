DATABASE_URL=postgresql://postgres:postgres@localhost:5432/solcage
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Set only after deploying and verifying the program.
SOLCAGE_LENDING_PROGRAM_ID=
SOLCAGE_BORROW_MINT=
SOLCAGE_BORROW_DECIMALS=6
SOLCAGE_BORROW_TOKEN_PROGRAM=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA

# One-line JSON. Start from config/collateral-markets.mainnet.json after the
# production program, USDC liquidity, risk controls, and market caps are audited.
# priceFeedAccount must be the fixed PDA derived from priceFeedId and
# priceFeedShardId. tokenProgram defaults to classic SPL Token when omitted.
SOLCAGE_COLLATERAL_MARKETS=[]
